<UserControl x:Class="FocusDesk.Views.TasksView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FocusDesk.ViewModels"
             x:DataType="vm:TasksViewModel"
             Background="Transparent">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16,24,12">
            <Grid>
                <TextBlock Text="Attività" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextSecondary}">
                    <Run Text="{Binding FilteredTasks.Count, Mode=OneWay}"/>
                    <Run Text=" attività"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Add task input -->
        <Border Grid.Row="1" Margin="24,0,24,16">
            <Border Classes="Card" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Classes="InputField"
                                 Text="{Binding NewTaskTitle}"
                                 Tag="Aggiungi nuova attività..." Margin="0,0,8,0">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="BtnPrimary"
                                Content="+" FontSize="20" Padding="14,10"
                                Command="{Binding AddTaskCommand}"/>
                    </Grid>

                    <!-- Pomodori stimati -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Pomodori stimati:" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Classes="BtnIcon" Content="−"
                                Command="{Binding DecrementEstimatedCommand}"/>
                        <TextBlock Text="{Binding NewTaskEstimatedPomodoros}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="10,0" Width="20"
                                   TextAlignment="Center"/>
                        <Button Classes="BtnIcon" Content="+"
                                Command="{Binding IncrementEstimatedCommand}"/>
                        <TextBlock Text="🍅" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Filter tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,0,24,12">
            <Button Classes="BtnGhost" Content="Tutte"
                    Command="{Binding SetFilterCommand}" CommandParameter="Tutte"
                    Classes.Active="{Binding FilterMode, Converter={StaticResource StringEquality}, ConverterParameter='Tutte'}"
                    Margin="0,0,6,0" Padding="14,7"/>
            <Button Classes="BtnGhost" Content="In Corso"
                    Command="{Binding SetFilterCommand}" CommandParameter="InCorso"
                    Classes.Active="{Binding FilterMode, Converter={StaticResource StringEquality}, ConverterParameter='InCorso'}"
                    Margin="0,0,6,0" Padding="14,7"/>
            <Button Classes="BtnGhost" Content="Completate"
                    Command="{Binding SetFilterCommand}" CommandParameter="Completate"
                    Classes.Active="{Binding FilterMode, Converter={StaticResource StringEquality}, ConverterParameter='Completate'}"
                    Padding="14,7"/>
        </StackPanel>

        <!-- Task list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="24,0,24,24">
            <ItemsControl ItemsSource="{Binding FilteredTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <Border Classes="Card" Margin="0,0,0,8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox replacement (Button) -->
                                <Button Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                        BorderThickness="2" Margin="0,0,12,0" Padding="0"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        Command="{Binding $parent[UserControl].DataContext.ToggleCompleteCommand}"
                                        CommandParameter="{Binding}"
                                        Classes.Completed="{Binding IsCompleted}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <Style Selector="Button.Completed">
                                            <Setter Property="Background" Value="{StaticResource AccentFocus}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentFocus}"/>
                                        </Style>
                                    </Button.Styles>
                                    <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="White"
                                               IsVisible="{Binding IsCompleted}"/>
                                </Button>

                                <!-- Contenuto task -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"
                                               Classes.Completed="{Binding IsCompleted}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                            <Style Selector="TextBlock.Completed">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>

                                    <!-- Pomodori -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PomodoroCount}">
                                                    <Binding Path="CompletedPomodoros"/>
                                                    <Binding Path="EstimatedPomodoros"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}/{1}">
                                                    <Binding Path="CompletedPomodoros"/>
                                                    <Binding Path="EstimatedPomodoros"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Azioni -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Seleziona per timer -->
                                    <Button Classes="BtnIcon" Content="▶"
                                            ToolTip.Tip="Usa nel timer"
                                            Command="{Binding $parent[UserControl].DataContext.SelectForTimerCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding !IsCompleted}"/>
                                    <!-- Elimina -->
                                    <Button Classes="BtnIcon" Content="🗑"
                                            ToolTip.Tip="Elimina"
                                            Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
