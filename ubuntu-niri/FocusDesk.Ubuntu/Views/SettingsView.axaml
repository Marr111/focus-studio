<UserControl x:Class="FocusDesk.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FocusDesk.ViewModels"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <TextBlock Text="Impostazioni" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <Button HorizontalAlignment="Right" Classes="BtnPrimary"
                        Content="💾 Salva" Command="{Binding SaveCommand}"
                        Padding="20,10" FontSize="13"/>
            </Grid>
            <!-- ══════════ SERVIZI AI ══════════ -->
            <TextBlock Text="🤖 SERVIZI AI" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource AccentFocus}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Google Gemini API Key" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Necessaria per generare piani di studio intelligenti. Puoi ottenerla gratuitamente da Google AI Studio." FontSize="12"
                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <TextBox Classes="InputField" Text="{Binding GeminiApiKey}" PasswordChar="•"
                             Watermark="Incolla qui la tua API Key..."/>
                </StackPanel>
            </Border>

            <!-- ══════════ TIMER ══════════ -->
            <TextBlock Text="⏱ TIMER" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource AccentFocus}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Durata Focus -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🍅 Pomodoro" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Durata sessione focus" FontSize="12"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="BtnIcon" Content="−" Width="28" Height="28"
                                    Click="DecFocus_Click"/>
                            <TextBox Classes="InputField"
                                     Text="{Binding FocusDuration}"
                                     Width="52" TextAlignment="Center" Margin="6,0" FontSize="15"
                                     FontWeight="SemiBold" Padding="4"/>
                            <Button Classes="BtnIcon" Content="+" Width="28" Height="28"
                                    Click="IncFocus_Click"/>
                            <TextBlock Text="min" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <!-- Pausa breve -->
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="☕ Pausa Breve" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Durata pausa corta" FontSize="12"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="BtnIcon" Content="−" Width="28" Height="28"
                                    Click="DecShort_Click"/>
                            <TextBox Classes="InputField"
                                     Text="{Binding ShortBreakDuration}"
                                     Width="52" TextAlignment="Center" Margin="6,0" FontSize="15"
                                     FontWeight="SemiBold" Padding="4"/>
                            <Button Classes="BtnIcon" Content="+" Width="28" Height="28"
                                    Click="IncShort_Click"/>
                            <TextBlock Text="min" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <!-- Pausa lunga -->
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🌙 Pausa Lunga" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Durata pausa lunga" FontSize="12"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="BtnIcon" Content="−" Width="28" Height="28"
                                    Click="DecLong_Click"/>
                            <TextBox Classes="InputField"
                                     Text="{Binding LongBreakDuration}"
                                     Width="52" TextAlignment="Center" Margin="6,0" FontSize="15"
                                     FontWeight="SemiBold" Padding="4"/>
                            <Button Classes="BtnIcon" Content="+" Width="28" Height="28"
                                    Click="IncLong_Click"/>
                            <TextBlock Text="min" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <!-- Sessioni prima della pausa lunga -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🔄 Sessioni per pausa lunga" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Pomodori prima della pausa lunga" FontSize="12"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="BtnIcon" Content="−" Width="28" Height="28"
                                    Click="DecCycle_Click"/>
                            <TextBox Classes="InputField"
                                     Text="{Binding SessionsBeforeLongBreak}"
                                     Width="52" TextAlignment="Center" Margin="6,0" FontSize="15"
                                     FontWeight="SemiBold" Padding="4"/>
                            <Button Classes="BtnIcon" Content="+" Width="28" Height="28"
                                    Click="IncCycle_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ EFFETTI AUDIO ══════════ -->
            <TextBlock Text="🎵 EFFETTI AUDIO" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource AccentFocus}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Ticchettio -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ticchettio Timer" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Suono continuo durante il focus" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTickingSounds}" 
                                  SelectedItem="{Binding SelectedTickingSound}"
                                  Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                                  IsEnabled="{Binding EnableTickingSound}"/>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding EnableTickingSound}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <!-- Allarmi -->
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sveglia fine sessione" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Suono al completamento di pomodori e pause" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAlarmSounds}" 
                                  SelectedItem="{Binding SelectedAlarmSound}"
                                  Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                                  IsEnabled="{Binding EnableAlarmSound}"/>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding EnableAlarmSound}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <!-- Suoni UI -->
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Suoni Interfaccia" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Click sui bottoni e interazioni varie" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableUiSounds}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <!-- Regolazione Volume -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Regolazione Volume" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Regola il volume dell'applicazione" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ COMPORTAMENTO ══════════ -->
            <TextBlock Text="🎛 COMPORTAMENTO" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource AccentBreakS}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,14,0,14">
                        <TextBlock Text="Auto-avvia pause" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding AutoStartBreaks}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <Grid Margin="0,14,0,14">
                        <TextBlock Text="Auto-avvia pomodoro" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding AutoStartFocus}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Minimizza nel tray" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding MinimizeToTray}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ FOCUS MODE ══════════ -->
            <TextBlock Text="🚀 FOCUS MODE" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource AccentBreakL}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Isolamento Desktop" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Crea un desktop separato solo con le app whitelist"
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding EnableDesktopIsolation}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>
                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Blocco Siti Web" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Blocca i siti nella lista nera durante la sessione"
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding EnableWebsiteBlocking}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ WHITELIST APP ══════════ -->
            <TextBlock Text="📱 WHITELIST APP" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <Button Classes="BtnGhost" Content="+ Aggiungi applicazione"
                            Command="{Binding AddWhitelistAppCommand}"
                            HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding WhitelistApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding ExecutablePath, Converter={StaticResource ExePathToIcon}}" Width="24" Height="24" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="BtnIcon" Content="✕"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveWhitelistAppCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nessuna app configurata" FontSize="13"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                               Margin="0,8" IsVisible="{Binding !WhitelistApps.Count}"/>
                </StackPanel>
            </Border>

            <!-- ══════════ SITI BLOCCATI ══════════ -->
            <TextBlock Text="🚫 SITI BLOCCATI" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Preset buttons -->
                    <TextBlock Text="Preset rapidi:" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Classes="BtnGhost" Content="📱 Social"
                                Command="{Binding AddSocialPresetCommand}"
                                Padding="12,6" Margin="0,0,6,6" FontSize="12"/>
                        <Button Classes="BtnGhost" Content="📰 News"
                                Command="{Binding AddNewsPresetCommand}"
                                Padding="12,6" Margin="0,0,6,6" FontSize="12"/>
                        <Button Classes="BtnGhost" Content="📺 Video"
                                Command="{Binding AddVideoPresetCommand}"
                                Padding="12,6" Margin="0,0,6,6" FontSize="12"/>
                    </WrapPanel>

                    <!-- Aggiungi dominio custom -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Classes="InputField"
                                 Text="{Binding NewBlockedDomain}"
                                 Watermark="es. esempio.com" Margin="0,0,8,0">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddBlockedSiteCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="BtnPrimary"
                                Content="+" FontSize="18" Padding="12,10"
                                Command="{Binding AddBlockedSiteCommand}"/>
                    </Grid>

                    <!-- Lista siti -->
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BlockedSites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Enable toggle -->
                                        <ToggleSwitch Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled}"
                                                  Margin="0,0,10,0"/>
                                        <!-- Domain -->
                                        <TextBlock Grid.Column="1" Text="{Binding Domain}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <!-- Category badge -->
                                        <Border Grid.Column="2" Background="{StaticResource BgElevated}"
                                                CornerRadius="4" Padding="6,2" Margin="6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{StaticResource TextMuted}"/>
                                        </Border>
                                        <!-- Delete -->
                                        <Button Grid.Column="3" Classes="BtnIcon" Content="✕"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveBlockedSiteCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Spacer bottom -->
            <Border Height="24"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
