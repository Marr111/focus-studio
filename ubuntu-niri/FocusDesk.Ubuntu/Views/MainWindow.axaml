<Window x:Class="FocusDesk.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FocusDesk.ViewModels"
        xmlns:views="using:FocusDesk.Views"
        xmlns:models="using:FocusDesk.Models"
        Title="FocusDesk" Width="500" Height="740"
        MinWidth="440" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Classes="FocusDeskWindow"
        Icon="avares://FocusDesk.Ubuntu/Resources/AppIcon.ico"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        x:DataType="vm:MainViewModel">

    <!-- Sfondo con bordi arrotondati -->
    <Border CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <Binding Path="CurrentMode" Converter="{StaticResource SessionTypeToBackground}"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="60"/>   <!-- Bottom nav -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════ TITLE BAR ═══════════════════ -->
            <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Profile Image Avatar -->
                        <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" Background="{StaticResource AccentFocus}">
                            <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        
                        <TextBlock Text="🍅" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="FocusDesk" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        
                        <!-- Focus Mode indicator -->
                        <Border Margin="12,0,0,0" VerticalAlignment="Center"
                                Background="#40E94560" CornerRadius="8" Padding="8,3"
                                IsVisible="{Binding IsFocusModeActive}">
                            <TextBlock Text="● FOCUS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentFocus}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Pulsanti Windows (HitTestVisible) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0" IsHitTestVisible="True">
                <Button Classes="BtnIcon" Click="Minimize_Click">
                    <PathIcon Data="M 0 4 L 10 4 L 10 6 L 0 6 Z" Width="10" Height="10"/>
                </Button>
                <Button Classes="BtnIcon" Click="Maximize_Click">
                    <PathIcon Data="M 0 0 L 10 0 L 10 10 L 0 10 Z M 2 2 L 2 8 L 8 8 L 8 2 Z" Width="10" Height="10"/>
                </Button>
                <Button Classes="BtnIcon" Click="Close_Click">
                    <PathIcon Data="M 1 2 L 2 1 L 5 4 L 8 1 L 9 2 L 6 5 L 9 8 L 8 9 L 5 6 L 2 9 L 1 8 L 4 5 Z" Width="10" Height="10"/>
                </Button>
            </StackPanel>

            <!-- ═══════════════════ CONTENT ═══════════════════ -->
            <Grid Grid.Row="1">
                <!-- TAB TIMER -->
                <ScrollViewer x:Name="TimerTab" VerticalScrollBarVisibility="Auto"
                              IsVisible="True">
                    <StackPanel Margin="24,8,24,24">

                        <!-- Mode selector -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="12"
                                Padding="4" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SwitchModeCommand}" CommandParameter="Focus"
                                        Classes="BtnModeTab" Background="{Binding CurrentMode, Converter={StaticResource ModeTabBackground}, ConverterParameter=Focus}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <TextBlock Text="🍅 Pomodoro" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                
                                <Button Grid.Column="1" Command="{Binding SwitchModeCommand}" CommandParameter="PausaBreve"
                                        Classes="BtnModeTab" Background="{Binding CurrentMode, Converter={StaticResource ModeTabBackground}, ConverterParameter=PausaBreve}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <TextBlock Text="☕ Pausa Breve" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                
                                <Button Grid.Column="2" Command="{Binding SwitchModeCommand}" CommandParameter="PausaLunga"
                                        Classes="BtnModeTab" Background="{Binding CurrentMode, Converter={StaticResource ModeTabBackground}, ConverterParameter=PausaLunga}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <TextBlock Text="🌙 Pausa Lunga" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Timer circolare -->
                        <Viewbox Stretch="Uniform" MaxHeight="350" Margin="0,0,0,20">
                            <Grid HorizontalAlignment="Center" Width="220" Height="220">
                                <!-- Cerchio sfondo -->
                                <Ellipse Width="220" Height="220" StrokeThickness="10"
                                         Stroke="{StaticResource BgElevated}" Fill="Transparent"/>
                                <!-- Cerchio progresso -->
                                <Ellipse x:Name="ProgressRing" Width="220" Height="220"
                                         StrokeThickness="10" Fill="Transparent"
                                         Stroke="{Binding CurrentMode, Converter={StaticResource SessionTypeToColor}}"
                                         RenderTransformOrigin="50%,50%"
                                         StrokeDashArray="502,502"
                                         StrokeDashOffset="0">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
    
                                <!-- Timer text al centro -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TimerDisplay}"
                                               FontSize="52" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Light"/>
                                    <TextBlock HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"
                                               Text="{Binding CurrentMode, Converter={StaticResource IntToString}, ConverterParameter=ModeName}"/>
                                </StackPanel>
                            </Grid>
                        </Viewbox>

                        <!-- Contatore sessioni ciclo -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,0,0,24">
                            <TextBlock Text="🍅" FontSize="16" Margin="3,0"/>
                            <TextBlock Text="{Binding SessionsDoneToday}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text=" pomodori oggi"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Bottoni controllo timer -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button Classes="BtnPrimary"
                                    Content="{Binding StartButtonText}"
                                    Command="{Binding ToggleTimerCommand}"
                                    MinWidth="180" Margin="0,0,0,12"/>
                            <Button Classes="BtnGhost"
                                    Content="⟳ Reset" HorizontalAlignment="Center"
                                    Command="{Binding ResetTimerCommand}"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8"/>

                        <!-- Task corrente -->
                        <TextBlock Text="TASK CORRENTE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,8,0,10"/>

                        <Border Classes="Card" Padding="16">
                            <Grid>
                                <ComboBox ItemsSource="{Binding Tasks}"
                                          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                          IsVisible="{Binding SelectedTask, Converter={StaticResource InverseBoolToVisibility}}"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,0" Height="28" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel IsVisible="{Binding SelectedTask, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedTask.Title}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PomodoroCount}">
                                                    <Binding Path="SelectedTask.CompletedPomodoros"/>
                                                    <Binding Path="SelectedTask.EstimatedPomodoros"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Classes="BtnGhost" Content="✕ Cambia/Deseleziona"
                                                Command="{Binding SelectTaskCommand}"
                                                CommandParameter="{x:Null}"
                                                Padding="8,4" FontSize="11" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Focus Mode button -->
                        <Border Margin="0,16,0,0" CornerRadius="12" Padding="1"
                                HorizontalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E94560" Offset="0"/>
                                    <GradientStop Color="#8B1A7E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Background="{StaticResource BgCard}"
                                    Foreground="{StaticResource TextPrimary}"
                                    FontSize="14" FontWeight="SemiBold"
                                    Command="{Binding ToggleFocusModeCommand}"
                                    Content="{Binding FocusModeButtonText}"
                                    BorderThickness="0" Padding="0,14"
                                    Cursor="Hand" HorizontalAlignment="Stretch" CornerRadius="11">
                            </Button>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- TAB ATTIVITÀ -->
                <views:TasksView x:Name="TasksTab" IsVisible="False"/>

                <!-- TAB STATISTICHE -->
                <views:StatsView x:Name="StatsTab" IsVisible="False"/>

                <!-- TAB AGENDA -->
                <views:AgendaView x:Name="AgendaTab" IsVisible="False"/>

                <!-- TAB IMPOSTAZIONI -->
                <views:SettingsView x:Name="SettingsTab" IsVisible="False"/>
                
                <!-- TAB PIANO AI -->
                <views:AIPlannerView x:Name="AIPlannerTab" IsVisible="False"/>
            </Grid>

            <!-- ═══════════════════ BOTTOM NAV ═══════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="NavTimer" Classes="BtnNav"
                            Click="NavTimer_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <PathIcon Data="M15,1H9V3H15V1M11,14H13V8H11V14M19.03,7.39L20.45,5.97C20,5.46 19.55,5 19.04,4.56L17.62,6C16.07,4.74 14.12,4 12,4C7.03,4 3,8.03 3,13C3,17.97 7.02,22 12,22C16.98,22 21,17.97 21,13C21,10.88 20.26,8.93 19.03,7.39M12,20C8.13,20 5,16.87 5,13C5,9.13 8.13,6 12,6C15.87,6 19,9.13 19,13C19,16.87 15.87,20 12,20Z" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Timer" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="NavTasks" Classes="BtnNav"
                            Click="NavTasks_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,20V6C21,4.9 20.1,4 19,4H5V2H16V4H19V6H16V2H19V4H15.5C15.25,4 15,4.25 15,4.5V5.5C15,5.75 15.25,6 15.5,6H19V19H5V19H19V19M19,19H5V10H19V19M19,8H5V6H19V8Z" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Attività" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="NavAgenda" Classes="BtnNav"
                            Click="NavAgenda_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <PathIcon Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3.01,4.9 3.01,6L3,20C3,21.1 3.89,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4H5V2H16V4H19V6H16V2H19V4H15.5C15.25,4 15,4.25 15,4.5V5.5C15,5.75 15.25,6 15.5,6H19V19H5V19H19V19M19,19H5V10H19V19M19,8H5V6H19V8Z" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Agenda" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" x:Name="NavAIPlanner" Classes="BtnNav"
                            Click="NavAIPlanner_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <!-- Icona AI / Robot -->
                            <PathIcon Data="M12,2A2,2 0 0,1 14,4A2,2 0 0,1 12,6A2,2 0 0,1 10,4A2,2 0 0,1 12,2M16.5,8H7.5A2.5,2.5 0 0,0 5,10.5V17A2,2 0 0,0 7,19H8V22H10V19H14V22H16V19H17A2,2 0 0,0 19,17V10.5A2.5,2.5 0 0,0 16.5,8M9,13H7V11H9V13M17,13H15V11H17V13Z" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Piano AI" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" x:Name="NavStats" Classes="BtnNav"
                            Click="NavStats_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Statistiche" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" x:Name="NavSettings" Classes="BtnNav"
                            Click="NavSettings_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Width="20" Height="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Impostazioni" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Nuovo slider per il volume -->
            <Border Grid.Row="1" Margin="24,24,24,0" Background="{StaticResource BgCard}" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="280" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
