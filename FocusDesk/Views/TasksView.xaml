<UserControl x:Class="FocusDesk.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusDesk.ViewModels"
             xmlns:dd="urn:gong-wpf-dragdrop"
             Background="Transparent">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16,24,12">
            <Grid>
                <TextBlock Text="Attività" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextSecondary}">
                    <Run Text="{Binding FilteredTasks.Count, Mode=OneWay}"/>
                    <Run Text=" attività"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Add task input -->
        <Border Grid.Row="1" Margin="24,0,24,16">
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputField}"
                                 Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Aggiungi nuova attività..." Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}"
                                Content="+" FontSize="20" Padding="14,10"
                                Command="{Binding AddTaskCommand}"/>
                    </Grid>

                    <!-- Pomodori stimati -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Pomodori stimati:" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BtnIcon}" Content="−"
                                Command="{Binding DecrementEstimatedCommand}"/>
                        <TextBlock Text="{Binding NewTaskEstimatedPomodoros}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="10,0" Width="20"
                                   TextAlignment="Center"/>
                        <Button Style="{StaticResource BtnIcon}" Content="+"
                                Command="{Binding IncrementEstimatedCommand}"/>
                        <TextBlock Text="🍅" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Filter tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,0,24,12">
            <Button Style="{StaticResource BtnGhost}" Content="Tutte"
                    Command="{Binding SetFilterCommand}" CommandParameter="Tutte"
                    Margin="0,0,6,0" Padding="14,7"/>
            <Button Style="{StaticResource BtnGhost}" Content="In Corso"
                    Command="{Binding SetFilterCommand}" CommandParameter="InCorso"
                    Margin="0,0,6,0" Padding="14,7"/>
            <Button Style="{StaticResource BtnGhost}" Content="Completate"
                    Command="{Binding SetFilterCommand}" CommandParameter="Completate"
                    Padding="14,7"/>
        </StackPanel>

        <!-- Task list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="24,0,24,24">
            <ItemsControl ItemsSource="{Binding FilteredTasks}"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DropHandler="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                        BorderThickness="2" Margin="0,0,12,0"
                                        VerticalAlignment="Center" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentFocus}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentFocus}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"/>
                                </Border>

                                <!-- Contenuto task -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"
                                               FontWeight="{Binding IsCompleted, Converter={StaticResource BoolToFontWeight}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Pomodori -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PomodoroCount}">
                                                    <Binding Path="CompletedPomodoros"/>
                                                    <Binding Path="EstimatedPomodoros"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}/{1}">
                                                    <Binding Path="CompletedPomodoros"/>
                                                    <Binding Path="EstimatedPomodoros"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Azioni -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Seleziona per timer -->
                                    <Button Style="{StaticResource BtnIcon}" Content="▶"
                                            ToolTip="Usa nel timer"
                                            Command="{Binding DataContext.SelectForTimerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <!-- Elimina -->
                                    <Button Style="{StaticResource BtnIcon}" Content="🗑"
                                            ToolTip="Elimina"
                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
